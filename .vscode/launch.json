{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/api/bin/Debug/net10.0/FootballGm.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "console": "internalConsole"
    },
    {
      "name": "Flutter (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "deviceId": "windows"
    }
  ],
  "compounds": [
    {
      "name": "API + Flutter",
      "configurations": ["API (http)", "Flutter (Windows)"],
      "stopAll": true
    }
  ]
}
