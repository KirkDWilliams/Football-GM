# Start API: dotnet run --project api/FootballGm.Api.csproj --launch-profile http
# After login/register, paste tokens into the variables below.
@FootballGm.Api_HostAddress = http://localhost:5000
@accessToken = replace-with-access-token
@refreshToken = replace-with-refresh-token

### Health check (anonymous)
GET {{FootballGm.Api_HostAddress}}/api/health
Accept: application/json

### OpenAPI document
GET {{FootballGm.Api_HostAddress}}/openapi/v1.json
Accept: application/json

### Register a user (returns access + refresh tokens)
POST {{FootballGm.Api_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "gm@example.com",
  "password": "correct-horse-battery",
  "displayName": "Nick",
  "deviceName": "http-file"
}

### Login (returns access + refresh tokens)
POST {{FootballGm.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "gm@example.com",
  "password": "correct-horse-battery",
  "deviceName": "http-file"
}

### Refresh (rotates refresh token; returns new access + refresh)
POST {{FootballGm.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Logout (revokes the refresh token)
POST {{FootballGm.Api_HostAddress}}/api/auth/logout
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Current user from database (requires Authorization header)
GET {{FootballGm.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

### Change password (requires access token; revokes all refresh sessions — re-login after)
POST {{FootballGm.Api_HostAddress}}/api/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "currentPassword": "correct-horse-battery",
  "newPassword": "new-correct-horse"
}

### Mint a JWT (Development only — access token only, no user account lookup)
POST {{FootballGm.Api_HostAddress}}/api/tokens
Content-Type: application/json
Accept: application/json

{
  "subject": "dev-user-1",
  "displayName": "Dev GM"
}

### Verify bearer token claims (requires Authorization header)
GET {{FootballGm.Api_HostAddress}}/api/tokens/me
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create a league (requires access token; omit rules to use standard weights)
POST {{FootballGm.Api_HostAddress}}/api/league
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "Poop League"
}

### List my leagues (slim summaries)
GET {{FootballGm.Api_HostAddress}}/api/league
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get one league I belong to (full settings + role)
GET {{FootballGm.Api_HostAddress}}/api/league/1
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get a player identity only (requires access token)
GET {{FootballGm.Api_HostAddress}}/api/player/00-0033873
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get a player scored for a league/game (requires access token)
GET {{FootballGm.Api_HostAddress}}/api/player/00-0033873?leagueId=1&gameId=2024_01_KC_BAL&stats=PreviousWeek
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get a player scored for the current season (requires access token)
GET {{FootballGm.Api_HostAddress}}/api/player/00-0033873?leagueId=1&stats=Season
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get a player scored for recent games and the current season (requires access token)
GET {{FootballGm.Api_HostAddress}}/api/player/00-0033873?leagueId=1&stats=RecentThreeGames&stats=Season
Authorization: Bearer {{accessToken}}
Accept: application/json
